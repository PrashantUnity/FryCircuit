<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FryCircuit.UI.ViewModels"
        xmlns:controls="using:FryCircuit.UI.Controls"
        xmlns:theming="using:FryCircuit.UI.Theming"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="FryCircuit.UI.Views.CircuitStudioView"
        x:DataType="vm:MainWindowViewModel"
        Background="{DynamicResource CircuitBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FryCircuit.UI/Styles/Tokens/CircuitPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://FryCircuit.UI/Styles/CircuitStyles.axaml" />

        <!-- Mode Tool Button (Clean borderless flat design) -->
        <Style Selector="Button.modebtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusSm}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="{DynamicResource CircuitFontSizeBodySm}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modebtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
        </Style>
        <Style Selector="Button.modebtn:pressed">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceLowestBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Mode Tool Button Active State (Flat neutral highlight, white text, NO neon border) -->
        <Style Selector="Button.modebtn.active">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.modebtn.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ToggleButton Mode Button Styles (Flat clean toggles, NO neon borders) -->
        <Style Selector="ToggleButton.modebtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextDimBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusSm}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="{DynamicResource CircuitFontSizeBodySm}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.modebtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextDimBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusSm}"/>
        </Style>
        <Style Selector="ToggleButton.modebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
        </Style>
        <Style Selector="ToggleButton.modebtn:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ToggleButton.modebtn:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- Preset Quick Chip -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextDimBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusSm}"/>
            <Setter Property="Padding" Value="7,3.5"/>
            <Setter Property="FontSize" Value="{DynamicResource CircuitFontSizeBodySm}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.chip.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
        </Style>
        <Style Selector="Button.chip.probing">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitWarningBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.chip.probing /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitWarningBrush}"/>
        </Style>
        <Style Selector="Button.chip.probing2">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitAccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.chip.probing2 /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitAccentBrush}"/>
        </Style>

        <!-- Category Tab Buttons (Flat pills, active uses clean neutral surface, NO neon border) -->
        <Style Selector="Button.categoryTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusSm}"/>
            <Setter Property="Padding" Value="7,3.5"/>
            <Setter Property="FontSize" Value="{DynamicResource CircuitFontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.categoryTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
        </Style>
        <Style Selector="Button.categoryTab.active">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.categoryTab.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextWhiteBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Library Component Card Button -->
        <Style Selector="Button.libbtn">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource CircuitTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusMd}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.libbtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
        </Style>
        <Style Selector="Button.libbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
        </Style>
        <Style Selector="Button.libbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceLowestBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
        </Style>

        <!-- Mini Rail Button -->
        <Style Selector="Button.minirailbtn">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CircuitRadiusSm}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.minirailbtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CircuitSurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CircuitBorderLightBrush}"/>
        </Style>

        <!-- Green Accent Variant (For Simulation Speed & Timers) -->
        <Style Selector="Slider.green">
            <Setter Property="Foreground" Value="{DynamicResource CircuitSecondaryBrush}"/>
        </Style>
        <Style Selector="Slider.green:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource CircuitSecondaryHoverBrush}"/>
        </Style>
        <Style Selector="Slider.green:pressed">
            <Setter Property="Foreground" Value="{DynamicResource CircuitSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Header & Main Tool Controls -->
        <Border Grid.Row="0" Background="{DynamicResource CircuitHeaderBgBrush}" 
                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    
                    <!-- App Title & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border CornerRadius="6" Width="26" Height="26" Background="{DynamicResource CircuitSurfaceHighBrush}"
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1">
                            <material:MaterialIcon Kind="LightningBolt" Width="15" Height="15" 
                                                   Foreground="{DynamicResource CircuitAccentBrush}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="-1">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="FryCircuit" FontSize="{DynamicResource CircuitFontSizeTitle}" 
                                           FontWeight="Bold" Foreground="{DynamicResource CircuitTextWhiteBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="CAD" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                               FontWeight="Bold" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- File Status Badge / Name -->
                        <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="6,2.5" VerticalAlignment="Center" Margin="2,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" 
                                                       Foreground="{DynamicResource CircuitTextDimBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentFileName}" MaxWidth="110" TextTrimming="CharacterEllipsis" 
                                           FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource CircuitTextBrush}" VerticalAlignment="Center"/>
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource CircuitAccentBrush}" 
                                        IsVisible="{Binding IsDirty}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tool Mode Selector & File Operations -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <!-- File Menu Dropdown -->
                        <Button Classes="modebtn" ToolTip.Tip="File Operations (New, Open, Save)">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="FolderOutline" Width="13" Height="13" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                <TextBlock Text="File" FontSize="{DynamicResource CircuitFontSizeBody}"/>
                                <material:MaterialIcon Kind="ChevronDown" Width="11" Height="11" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="New Blank Circuit" Command="{Binding NewCircuitCommand}" InputGesture="Ctrl+N"/>
                                    <MenuItem Header="Open Circuit... (.frycircuit)" Command="{Binding OpenCircuitFileDialogCommand}" InputGesture="Ctrl+O"/>
                                    <Separator/>
                                    <MenuItem Header="Save Circuit" Command="{Binding SaveCircuitCommand}" InputGesture="Ctrl+S"/>
                                    <MenuItem Header="Save Circuit As..." Command="{Binding SaveCircuitAsDialogCommand}" InputGesture="Ctrl+Shift+S"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Toggle Left Library Panel -->
                        <ToggleButton Classes="modebtn" IsChecked="{Binding IsLeftPanelOpen, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle Component Library Panel">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="ViewGridOutline" Width="13" Height="13"/>
                                <TextBlock Text="Lib" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Toggle Oscilloscope Bottom Panel -->
                        <ToggleButton Classes="modebtn" IsChecked="{Binding IsOscilloscopeOpen, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle Oscilloscope Signal Panel">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="SineWave" Width="13" Height="13"/>
                                <TextBlock Text="Scope" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Toggle Inspector Right Panel -->
                        <ToggleButton Classes="modebtn" IsChecked="{Binding IsInspectorOpen, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle Circuit Inspector Panel">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="TuneVariant" Width="13" Height="13"/>
                                <TextBlock Text="Props" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ToggleButton>

                        <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Width="1" Height="16" Margin="2,0"/>

                        <!-- Primary CAD Mode Segmented Bar -->
                        <Border Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="modebtn" Classes.active="{Binding IsSelectMode}" 
                                        Command="{Binding SetToolModeCommand}" CommandParameter="select" ToolTip.Tip="Selection &amp; Drag Mode (V)">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="CursorDefaultOutline" Width="12" Height="12"/>
                                        <TextBlock Text="Select"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="modebtn" Classes.active="{Binding IsWireMode}" 
                                        Command="{Binding SetToolModeCommand}" CommandParameter="wire" ToolTip.Tip="Schematic Wiring Mode (W)">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="VectorPolyline" Width="12" Height="12"/>
                                        <TextBlock Text="Wire"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="modebtn" Classes.active="{Binding IsCutMode}" 
                                        Command="{Binding SetToolModeCommand}" CommandParameter="cut" ToolTip.Tip="Wire Cutting Tool (X)">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="ContentCut" Width="12" Height="12"/>
                                        <TextBlock Text="Cut"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Classes="modebtn" ToolTip.Tip="Rotate 90° Clockwise (R)" Command="{Binding RotateSelectedCommand}">
                            <material:MaterialIcon Kind="RotateRight" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="modebtn" ToolTip.Tip="Delete Selected (Del)" Command="{Binding DeleteSelectedCommand}">
                            <material:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13"/>
                        </Button>

                        <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Width="1" Height="16" Margin="2,0"/>

                        <Button Classes="modebtn" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoLabel}">
                            <material:MaterialIcon Kind="Undo" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="modebtn" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoLabel}">
                            <material:MaterialIcon Kind="Redo" Width="13" Height="13"/>
                        </Button>

                        <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Width="1" Height="16" Margin="2,0"/>

                        <!-- Live Circuit Visual Overlays -->
                        <ToggleButton Classes="modebtn" IsChecked="{Binding ShowCurrentAnnotations, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle Live Branch Currents (Animated direction arrows &amp; values)">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="LightningBoltCircle" Width="13" Height="13"/>
                                <TextBlock Text="I" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="Bold"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="modebtn" IsChecked="{Binding ShowVoltageAnnotations, Mode=TwoWay}"
                                      ToolTip.Tip="Toggle Live Node Voltages (Junction &amp; rail badges)">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="AlphaVCircleOutline" Width="13" Height="13"/>
                                <TextBlock Text="V" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="Bold"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Right: Simulation Controls, Presets, and Theme Switcher -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,2,0">
                        <!-- Simulation Play/Pause -->
                        <Button Classes="toolbtn" Classes.simplay="{Binding IsSimulating}" Command="{Binding ToggleSimulationCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="{Binding PlayPauseIconKind}" Width="13" Height="13"/>
                                <TextBlock Text="{Binding PlayPauseButtonText}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbtn" ToolTip.Tip="Single Step (0.25 ms)" Command="{Binding StepSimulationCommand}">
                            <material:MaterialIcon Kind="StepForward" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="toolbtn" ToolTip.Tip="Reset Simulation Time" Command="{Binding ResetSimulationCommand}">
                            <material:MaterialIcon Kind="Restart" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="toolbtn" ToolTip.Tip="Zoom to Fit Canvas" Command="{Binding ZoomToFitCommand}">
                            <material:MaterialIcon Kind="FitToScreenOutline" Width="13" Height="13"/>
                        </Button>
                        <Button Classes="toolbtn" Command="{Binding ToggleSpiceDrawerCommand}" ToolTip.Tip="Inspect &amp; export Berkeley SPICE / LTspice netlist">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="CodeJson" Width="13" Height="13"/>
                                <TextBlock Text="SPICE" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbtn" Command="{Binding ToggleBomDrawerCommand}" ToolTip.Tip="Generate and view manufacturing Bill of Materials">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="FileTableOutline" Width="13" Height="13"/>
                                <TextBlock Text="BOM" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbtn" Command="{Binding ToggleLlmDrawerCommand}" ToolTip.Tip="AI Circuit Assistant: Prompt, Schema &amp; .fcircuit Deck">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <material:MaterialIcon Kind="AutoFixHigh" Width="13" Height="13" Foreground="{DynamicResource CircuitAccentCyanBrush}"/>
                                <TextBlock Text="AI DECK" FontSize="{DynamicResource CircuitFontSizeBodySm}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Simulation Speed Slider -->
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="2,0,2,0">
                            <Slider Width="44" Minimum="0.1" Maximum="4.0" Value="{Binding SimulationSpeed}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                    BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                    CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="4,1.5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SimulationSpeed, StringFormat='{}{0:F1}x'}" 
                                           Foreground="{DynamicResource CircuitTextDimBrush}" FontWeight="Bold" 
                                           FontSize="{DynamicResource CircuitFontSizeMicro}" FontFamily="{DynamicResource CircuitCodeFont}" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Presets Selection -->
                        <ComboBox ItemsSource="{Binding AvailablePresets}" 
                                  SelectedItem="{Binding SelectedPreset}"
                                  Width="160" MaxDropDownHeight="360"
                                  Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                  Foreground="{DynamicResource CircuitTextBrush}" 
                                  BorderBrush="{DynamicResource CircuitBorderBrush}" 
                                  CornerRadius="{DynamicResource CircuitRadiusMd}" 
                                  FontSize="{DynamicResource CircuitFontSizeSmall}"
                                  ToolTip.Tip="{Binding SelectedPreset}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Theme Toggle Button (Dark <-> Light) -->
                        <Button Classes="toolbtn" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeTooltip}">
                            <material:MaterialIcon Kind="{Binding ThemeIconKind}" Width="14" Height="14" Foreground="{DynamicResource CircuitAccentBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Main Workspace: Left Library Sidebar + Canvas & Probes + Right Inspector Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding InspectorColumnWidth}" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Collapsible Component & Device Library -->
            <Border Grid.Column="0" Background="{DynamicResource CircuitSurfaceLowBrush}" 
                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Expanded Panel View (Width: 246px) -->
                    <Border Width="246" IsVisible="{Binding IsLeftPanelOpen}">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8,8,6,8">
                            
                            <!-- Panel Header with Title and Collapse Button -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,2,4,8">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="PackageVariantClosed" Width="14" Height="14" 
                                                           Foreground="{DynamicResource CircuitAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="COMPONENTS" FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeBody}" 
                                               Foreground="{DynamicResource CircuitTextDimBrush}" LetterSpacing="0.8" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                            CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FilteredPaletteItems.Count}" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                   FontWeight="Bold" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="chip" Command="{Binding ToggleLeftPanelCommand}" ToolTip.Tip="Collapse Library Panel">
                                    <material:MaterialIcon Kind="ChevronLeft" Width="12" Height="12" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Real-time Filter Search Box -->
                            <Border Grid.Row="1" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                    CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="7,4" Margin="2,0,2,8">
                                <Grid ColumnDefinitions="Auto,*">
                                    <material:MaterialIcon Grid.Column="0" Kind="Magnify" Width="13" Height="13" 
                                                           Foreground="{DynamicResource CircuitTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ComponentSearchQuery, Mode=TwoWay}"
                                             PlaceholderText="Filter components..." FontSize="{DynamicResource CircuitFontSizeBody}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource CircuitTextWhiteBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Category Chips Filter -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Classes="categoryTab" Classes.active="{Binding IsAllSelected}" Content="All" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="All" Margin="1,2"/>
                                <Button Classes="categoryTab" Classes.active="{Binding IsPassivesSelected}" Content="Passives" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="Passives" Margin="1,2"/>
                                <Button Classes="categoryTab" Classes.active="{Binding IsSourcesSelected}" Content="Sources" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="Sources" Margin="1,2"/>
                                <Button Classes="categoryTab" Classes.active="{Binding IsSemiconductorsSelected}" Content="Semis" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="Semiconductors" Margin="1,2"/>
                                <Button Classes="categoryTab" Classes.active="{Binding IsQuantumSelected}" Content="Quantum" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="Quantum &amp; RF" Margin="1,2"/>
                                <Button Classes="categoryTab" Classes.active="{Binding IsLogicSelected}" Content="Logic" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="Logic &amp; ICs" Margin="1,2"/>
                                <Button Classes="categoryTab" Classes.active="{Binding IsMetersSelected}" Content="Meters" Command="{Binding SelectPaletteCategoryCommand}" CommandParameter="Meters &amp; Switches" Margin="1,2"/>
                            </WrapPanel>

                            <!-- Scrollable List of Component Cards -->
                            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding FilteredPaletteItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaletteItemViewModel">
                                            <Button Classes="libbtn" Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).StartPlacingDeviceCommand}" CommandParameter="{Binding Code}" ToolTip.Tip="{Binding ToolTip}">
                                                <Grid ColumnDefinitions="30,*,Auto">
                                                    <!-- Clean Monogram Emblem -->
                                                    <Border Grid.Column="0" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Symbol}" FontSize="{DynamicResource CircuitFontSizeBodySm}" 
                                                                   FontWeight="Bold" FontFamily="{DynamicResource CircuitCodeFont}" 
                                                                   Foreground="{Binding AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Name & Category -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource CircuitFontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource CircuitTextBrush}"/>
                                                        <TextBlock Text="{Binding Category}" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                                    </StackPanel>
                                                    <!-- Keycap Ref Badge -->
                                                    <Border Grid.Column="2" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                                            CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="5,2" VerticalAlignment="Center" IsVisible="{Binding HasHotkey}">
                                                        <TextBlock Text="{Binding Hotkey}" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                                   FontWeight="Bold" FontFamily="{DynamicResource CircuitCodeFont}" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Bottom Guidance Hint -->
                            <Border Grid.Row="4" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                    CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="7,5" Margin="2,6,2,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <material:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="12" Height="12" 
                                                           Foreground="{DynamicResource CircuitTextDimBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Click item to place on schematic grid" 
                                               FontSize="{DynamicResource CircuitFontSizeSmall}" FontWeight="Medium" 
                                               Foreground="{DynamicResource CircuitTextDimBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Collapsed Slim Mini Rail (Width: 42px) -->
                    <Border Width="42" IsVisible="{Binding !IsLeftPanelOpen}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="5" Margin="4,8" HorizontalAlignment="Center">
                                <!-- Expand Button -->
                                <Button Classes="chip" Command="{Binding ToggleLeftPanelCommand}" ToolTip.Tip="Expand Library Panel" Width="32" Height="30" Padding="0">
                                    <material:MaterialIcon Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>

                                <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Height="1" Margin="2,2"/>

                                <!-- Quick Placement Icons on Mini Rail with crisp MaterialIcons -->
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="resistor" ToolTip.Tip="Resistor (R)">
                                    <material:MaterialIcon Kind="Waveform" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="capacitor" ToolTip.Tip="Capacitor (C)">
                                    <material:MaterialIcon Kind="FormatAlignJustify" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="inductor" ToolTip.Tip="Inductor (L)">
                                    <material:MaterialIcon Kind="SineWave" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="vsource" ToolTip.Tip="DC Voltage (V)">
                                    <material:MaterialIcon Kind="LightningBolt" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="ground" ToolTip.Tip="Ground (G)">
                                    <material:MaterialIcon Kind="Earth" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="diode" ToolTip.Tip="Diode (D)">
                                    <material:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="led" ToolTip.Tip="LED (LED)">
                                    <material:MaterialIcon Kind="LightbulbOutline" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="npn" ToolTip.Tip="NPN BJT (Q)">
                                    <material:MaterialIcon Kind="Gate" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                                <Button Classes="minirailbtn" Command="{Binding StartPlacingDeviceCommand}" CommandParameter="spst" ToolTip.Tip="Switch (SW)">
                                    <material:MaterialIcon Kind="ToggleSwitchOutline" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Center: Schematic Canvas + Oscilloscope -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding CanvasRowHeight}" />
                    <RowDefinition Height="{Binding ScopeRowHeight}" />
                </Grid.RowDefinitions>

                <!-- Circuit Schematic Canvas + Floating Panel Badges -->
                <Grid Grid.Row="0" IsVisible="{Binding !IsOscilloscopeMaximized}">
                    <controls:CircuitCanvas x:Name="CanvasControl" 
                                            Circuit="{Binding CurrentCircuit}"
                                            SelectedDevice="{Binding SelectedDevice, Mode=TwoWay}"
                                            SelectedWire="{Binding SelectedWire, Mode=TwoWay}"
                                            ToolMode="{Binding ActiveToolMode, Mode=TwoWay}"
                                            ShowCurrentAnnotations="{Binding ShowCurrentAnnotations}"
                                            ShowVoltageAnnotations="{Binding ShowVoltageAnnotations}"/>

                    <!-- Floating Restore Inspector Badge when collapsed -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                            IsVisible="{Binding !IsInspectorOpen}">
                        <Button Classes="chip" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="Expand Inspector Panel">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <material:MaterialIcon Kind="ChevronLeft" Width="11" Height="11" Foreground="{DynamicResource CircuitWarningBrush}"/>
                                <TextBlock Text="Inspector" FontSize="{DynamicResource CircuitFontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource CircuitTextBrush}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Floating Restore Oscilloscope Badge when collapsed -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16"
                            IsVisible="{Binding !IsOscilloscopeOpen}">
                        <Button Classes="chip" Command="{Binding ToggleOscilloscopeCommand}" ToolTip.Tip="Expand Oscilloscope Panel">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <material:MaterialIcon Kind="SineWave" Width="13" Height="13" Foreground="{DynamicResource CircuitSecondaryBrush}"/>
                                <TextBlock Text="Oscilloscope" FontSize="{DynamicResource CircuitFontSizeBody}" FontWeight="SemiBold" Foreground="{DynamicResource CircuitTextBrush}"/>
                                <material:MaterialIcon Kind="ChevronUp" Width="11" Height="11" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>

                <!-- Oscilloscope Bottom Panel with Probing Controls -->
                <Border Grid.Row="1" Background="{DynamicResource CircuitScopeBgBrush}" 
                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding IsOscilloscopeOpen}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Oscilloscope Probe Control Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="6,2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon Kind="SineWave" Width="11" Height="11" Foreground="{DynamicResource CircuitSecondaryBrush}"/>
                                            <TextBlock Text="CHANNELS" FontSize="{DynamicResource CircuitFontSizeSmall}" FontWeight="Bold" 
                                                       Foreground="{DynamicResource CircuitTextDimBrush}" FontFamily="{DynamicResource CircuitCodeFont}"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Classes="chip" Classes.probing="{Binding IsProbingCh1}" Command="{Binding StartProbingCommand}" CommandParameter="1" ToolTip.Tip="Channel 1 (Amber) - Click to enter probe placement mode">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <material:MaterialIcon Kind="Eye" Width="12" Height="12" Foreground="{DynamicResource CircuitScopeCh1Brush}"/>
                                            <TextBlock Text="{Binding ProbedCh1Label}" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitScopeCh1Brush}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="chip" Classes.probing2="{Binding IsProbingCh2}" Command="{Binding StartProbingCommand}" CommandParameter="2" ToolTip.Tip="Channel 2 (Cyan) - Click to enter probe placement mode">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <material:MaterialIcon Kind="Eye" Width="12" Height="12" Foreground="{DynamicResource CircuitScopeCh2Brush}"/>
                                            <TextBlock Text="{Binding ProbedCh2Label}" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitScopeCh2Brush}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="chip" Command="{Binding ClearProbesCommand}" ToolTip.Tip="Reset to automatic signal probing">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon Kind="Restart" Width="11" Height="11" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                            <TextBlock Text="Reset Auto" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Interactive Signal Probing • 60 FPS" FontSize="{DynamicResource CircuitFontSizeSmall}" 
                                               Foreground="{DynamicResource CircuitTextMutedBrush}" VerticalAlignment="Center"/>

                                    <!-- Maximize / Restore Oscilloscope Button -->
                                    <Button Classes="chip" Command="{Binding ToggleMaximizeOscilloscopeCommand}" ToolTip.Tip="{Binding MaximizeOscilloscopeTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <material:MaterialIcon Kind="WindowMaximize" Width="11" Height="11" Foreground="{DynamicResource CircuitAccentBrush}"/>
                                            <TextBlock Text="{Binding MaximizeOscilloscopeLabel}" FontSize="{DynamicResource CircuitFontSizeSmall}" 
                                                       FontWeight="SemiBold" Foreground="{DynamicResource CircuitTextBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Collapse Oscilloscope Button -->
                                    <Button Classes="chip" Command="{Binding ToggleOscilloscopeCommand}" ToolTip.Tip="Collapse Oscilloscope">
                                        <material:MaterialIcon Kind="ChevronDown" Width="11" Height="11" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <controls:OscilloscopeControl Grid.Row="1" x:Name="Oscilloscope" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Sidebar: Live Electrical Inspector & Tuning Controls -->
            <Border Grid.Column="2" Width="315" IsVisible="{Binding IsInspectorOpen}" 
                    Background="{DynamicResource CircuitPanelBgBrush}" 
                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1,0,0,0" Padding="12,12,6,12">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="CIRCUIT INSPECTOR" FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeBody}" 
                                       Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="1" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="chip" Command="{Binding ToggleInspectorCommand}" ToolTip.Tip="Collapse Inspector Panel">
                                <material:MaterialIcon Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Selected Wire Card (Top Priority when a wire is selected) -->
                        <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusLg}" Padding="12"
                                BoxShadow="{DynamicResource CircuitCardShadow}"
                                IsVisible="{Binding HasSelectedWire}">
                            <StackPanel Spacing="10">
                                <!-- Header with Net Node and Delete Button -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="WIRE TRACE INSPECTOR" FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                   Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="1"/>
                                        <TextBlock Text="{Binding SelectedWireNodeId, StringFormat='Net Node #{0}'}" 
                                                   FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeHeading}" 
                                                   Foreground="{DynamicResource CircuitTextWhiteBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="chip" ToolTip.Tip="Cut Wire Trace (Del)" Command="{Binding DeleteSelectedCommand}" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="ContentCut" Width="13" Height="13" Foreground="{DynamicResource CircuitDangerBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Connected Endpoints Route Badge -->
                                <Border Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="8,5">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <material:MaterialIcon Grid.Column="0" Kind="VectorPolyline" Width="12" Height="12" 
                                                               Foreground="{DynamicResource CircuitTextDimBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedWireConnectionDescription}" 
                                                   FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextBrush}" 
                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedWireConnectionDescription}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Live Telemetry Grid (Potential & Rail Type) -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,6">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="POTENTIAL (V)" FontSize="{DynamicResource CircuitFontSizeMicro}" FontWeight="Bold" 
                                                       Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.5"/>
                                            <TextBlock Text="{Binding FormattedSelectedWireVoltage}" 
                                                       FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeLabel}" 
                                                       Foreground="{DynamicResource CircuitWarningBrush}"
                                                       FontFamily="{DynamicResource CircuitCodeFont}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,6">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="RAIL TYPE" FontSize="{DynamicResource CircuitFontSizeMicro}" FontWeight="Bold" 
                                                       Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.5"/>
                                            <TextBlock Text="{Binding SelectedWireRailTypeText}" 
                                                       FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeLabel}" 
                                                       Foreground="{Binding SelectedWireRailTypeColor}"
                                                       FontFamily="{DynamicResource CircuitCodeFont}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Height="1"/>

                                <!-- Oscilloscope Probing Section with the Eye Button -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="OSCILLOSCOPE PROBING" FontSize="{DynamicResource CircuitFontSizeMicro}" FontWeight="Bold" 
                                               Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.8"/>
                                    
                                    <!-- The Eye Toggle Button -->
                                    <Button Classes="primary" HorizontalAlignment="Stretch" Padding="10,8"
                                            Command="{Binding ToggleSelectedWireProbeCommand}"
                                            ToolTip.Tip="{Binding SelectedWireProbeButtonTooltip}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <material:MaterialIcon Grid.Column="0" Kind="{Binding SelectedWireProbeEyeIconKind}" Width="15" Height="15" 
                                                                   Foreground="{Binding SelectedWireProbeAccentBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedWireProbeButtonText}" FontWeight="SemiBold" 
                                                       FontSize="{DynamicResource CircuitFontSizeBody}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{Binding SelectedWireProbeAccentBrush}" 
                                                     IsVisible="{Binding IsSelectedWireProbed}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Quick Channel Selector Chips -->
                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                                        <Button Grid.Column="0" Classes="chip" Command="{Binding ProbeSelectedWireCh1Command}" 
                                                HorizontalAlignment="Stretch" ToolTip.Tip="Attach to Channel 1 (Amber)">
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource CircuitScopeCh1Brush}"/>
                                                <TextBlock Text="CH1" FontSize="{DynamicResource CircuitFontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource CircuitScopeCh1Brush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="chip" Command="{Binding ProbeSelectedWireCh2Command}" 
                                                HorizontalAlignment="Stretch" ToolTip.Tip="Attach to Channel 2 (Cyan)">
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource CircuitScopeCh2Brush}"/>
                                                <TextBlock Text="CH2" FontSize="{DynamicResource CircuitFontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource CircuitScopeCh2Brush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="chip" Command="{Binding DetachSelectedWireProbeCommand}" 
                                                IsVisible="{Binding IsSelectedWireProbed}" ToolTip.Tip="Detach probe from oscilloscope">
                                            <material:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Selected Component Card -->
                        <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusLg}" Padding="12"
                                BoxShadow="{DynamicResource CircuitCardShadow}"
                                IsVisible="{Binding HasSelectedDevice}">
                            <StackPanel Spacing="10">
                                
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding SelectedDeviceDisplayName, FallbackValue='No Selection'}" 
                                                   FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeHeading}" 
                                                   Foreground="{DynamicResource CircuitTextWhiteBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Background="{DynamicResource CircuitSurfaceHoverBrush}" 
                                                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                                    CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="5,1" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasSelectedDevice}">
                                                <TextBlock Text="{Binding SelectedDeviceCategoryName}" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                           FontWeight="Bold" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedDevice.Id, StringFormat='REF: #{0}', FallbackValue='Click device on canvas'}" 
                                                       FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextDimBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Quick Rotate / Delete Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelectedDevice}" VerticalAlignment="Center">
                                        <Button Classes="chip" ToolTip.Tip="Rotate 90° (R)" Command="{Binding RotateSelectedCommand}">
                                            <material:MaterialIcon Kind="RotateRight" Width="13" Height="13"/>
                                        </Button>
                                        <Button Classes="chip" ToolTip.Tip="Delete (Del)" Command="{Binding DeleteSelectedCommand}">
                                            <material:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Height="1"/>

                                <!-- Instantaneous Electrical Values -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,2,0,2" IsVisible="{Binding HasSelectedDevice}">
                                    <!-- Current Telemetry Card -->
                                    <Border Grid.Column="0" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="6,5">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Text="CURRENT (I)" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                       FontWeight="Bold" Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.5"/>
                                            <TextBlock Grid.Row="1" Text="{Binding SelectedDevice.FormattedCurrent, FallbackValue='0.00 A'}" 
                                                       FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip.Tip="{Binding SelectedDevice.FormattedCurrent}"
                                                       FontFamily="{DynamicResource CircuitCodeFont}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Voltage Telemetry Card -->
                                    <Border Grid.Column="1" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="6,5">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Text="VOLTAGE (ΔV)" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                       FontWeight="Bold" Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.5"/>
                                            <TextBlock Grid.Row="1" Text="{Binding SelectedDevice.FormattedVoltage, FallbackValue='0.00 V'}" 
                                                       FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitAccentBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip.Tip="{Binding SelectedDevice.FormattedVoltage}"
                                                       FontFamily="{DynamicResource CircuitCodeFont}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Power Telemetry Card -->
                                    <Border Grid.Column="2" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="6,5">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Text="POWER (P)" FontSize="{DynamicResource CircuitFontSizeMicro}" 
                                                       FontWeight="Bold" Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.5"/>
                                            <TextBlock Grid.Row="1" Text="{Binding SelectedDevice.FormattedPower, FallbackValue='0.00 W'}" 
                                                       FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitWarningBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip.Tip="{Binding SelectedDevice.FormattedPower}"
                                                       FontFamily="{DynamicResource CircuitCodeFont}"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- LED Color & Optics Selector -->
                                <StackPanel Spacing="6" IsVisible="{Binding IsLedSelected}">
                                    <TextBlock Text="LED Color &amp; Optics:" FontSize="{DynamicResource CircuitFontSizeSmall}" 
                                               Foreground="{DynamicResource CircuitTextDimBrush}" FontWeight="SemiBold"/>

                                    <!-- Active Color Badge -->
                                    <Border Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                            BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                            CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                    Background="{Binding SelectedLedColorBrush}"
                                                    BorderBrush="{DynamicResource CircuitTextWhiteBrush}" BorderThickness="1.5" Margin="0,0,8,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding SelectedLedColorName}" FontWeight="Bold" 
                                                           FontSize="{DynamicResource CircuitFontSizeBody}" Foreground="{DynamicResource CircuitTextBrush}"/>
                                                <TextBlock Text="{Binding InspectorValue, StringFormat='Emission: {0:F0} nm'}" 
                                                           FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                                    CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="6,2">
                                                <TextBlock Text="{Binding SelectedLedForwardVoltage, StringFormat='Vf ≈ {0:F1} V'}"
                                                           FontSize="{DynamicResource CircuitFontSizeSmall}" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource CircuitAccentBrush}" FontFamily="{DynamicResource CircuitCodeFont}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Color Preset Swatches -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="chip" Classes.active="{Binding IsRedSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Red" ToolTip.Tip="Red - 650nm (Vf ≈ 1.9V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#FF2020"/>
                                                <TextBlock Text="Red" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsOrangeSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Orange" ToolTip.Tip="Orange - 610nm (Vf ≈ 2.0V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#FF8C00"/>
                                                <TextBlock Text="Orange" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsYellowSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Yellow" ToolTip.Tip="Yellow - 585nm (Vf ≈ 2.1V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#FFD700"/>
                                                <TextBlock Text="Yellow" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsGreenSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Green" ToolTip.Tip="Green - 525nm (Vf ≈ 2.4V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#00E060"/>
                                                <TextBlock Text="Green" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsCyanSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Cyan" ToolTip.Tip="Cyan - 500nm (Vf ≈ 2.5V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#00F0FF"/>
                                                <TextBlock Text="Cyan" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsBlueSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Blue" ToolTip.Tip="Blue - 470nm (Vf ≈ 2.6V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#0080FF"/>
                                                <TextBlock Text="Blue" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsVioletSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="Violet" ToolTip.Tip="Violet - 405nm (Vf ≈ 3.1V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#8B00FF"/>
                                                <TextBlock Text="Violet" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="chip" Classes.active="{Binding IsWhiteSelected}" Command="{Binding SetLedColorCommand}" CommandParameter="White" ToolTip.Tip="White - Phosphor (Vf ≈ 3.2V)" Margin="1,2" Padding="6,3">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="#FFFFFF"/>
                                                <TextBlock Text="White" FontSize="{DynamicResource CircuitFontSizeSmall}"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Rotary Dial Adjuster -->
                                <Border Margin="0,2,0,0" IsVisible="{Binding ShowPrimaryKnob}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Primary Tuning Knob" FontSize="{DynamicResource CircuitFontSizeSmall}" 
                                                   FontWeight="SemiBold" Foreground="{DynamicResource CircuitTextDimBrush}" HorizontalAlignment="Center"/>
                                        <controls:RotaryKnobControl Height="80" Width="80" HorizontalAlignment="Center"
                                                                    Value="{Binding InspectorValue, Mode=TwoWay}"
                                                                    Minimum="{Binding InspectorMin}"
                                                                    Maximum="{Binding InspectorMax}"
                                                                    Unit="{Binding InspectorUnit}"
                                                                    Label="{Binding InspectorLabel}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Multi-Parameter Live Tuning Grid -->
                                <StackPanel Spacing="4" IsVisible="{Binding HasSelectedDevice}">
                                    <TextBlock Text="DEVICE PARAMETERS:" FontSize="{DynamicResource CircuitFontSizeSmall}" 
                                               FontWeight="Bold" Foreground="{DynamicResource CircuitTextMutedBrush}" LetterSpacing="0.5"/>
                                    <ItemsControl ItemsSource="{Binding DeviceParameters}">
                                        <ItemsControl.ItemTemplate>
                                             <DataTemplate x:DataType="vm:DeviceParameterViewModel">
                                                 <Border Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                                         BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                                         CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,5" Margin="0,2">
                                                     <StackPanel Spacing="3">
                                                         <Grid ColumnDefinitions="*,Auto">
                                                             <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="{DynamicResource CircuitFontSizeSmall}" 
                                                                        FontWeight="SemiBold" Foreground="{DynamicResource CircuitTextBrush}" VerticalAlignment="Center"/>
                                                             <TextBox Grid.Column="1" Text="{Binding EditText, Mode=TwoWay}"
                                                                      FontSize="{DynamicResource CircuitFontSizeSmall}" FontWeight="Bold" 
                                                                      Foreground="{DynamicResource CircuitAccentBrush}" FontFamily="{DynamicResource CircuitCodeFont}"
                                                                      Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                                                      BorderBrush="{DynamicResource CircuitBorderBrush}" 
                                                                      CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="5,2" Height="22" MinWidth="75"
                                                                      TextAlignment="Right" VerticalAlignment="Center"/>
                                                         </Grid>
                                                         <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                                                                 Margin="0,2,0,0" VerticalAlignment="Center"/>
                                                     </StackPanel>
                                                 </Border>
                                             </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Quick Value Preset Chips -->
                                <StackPanel Spacing="4" IsVisible="{Binding IsResistorSelected}">
                                    <TextBlock Text="Resistor Presets:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="chip" Content="100Ω" Command="{Binding SetInspectorPresetCommand}" CommandParameter="100" Margin="1,2"/>
                                        <Button Classes="chip" Content="1kΩ" Command="{Binding SetInspectorPresetCommand}" CommandParameter="1000" Margin="1,2"/>
                                        <Button Classes="chip" Content="4.7kΩ" Command="{Binding SetInspectorPresetCommand}" CommandParameter="4700" Margin="1,2"/>
                                        <Button Classes="chip" Content="10kΩ" Command="{Binding SetInspectorPresetCommand}" CommandParameter="10000" Margin="1,2"/>
                                        <Button Classes="chip" Content="100kΩ" Command="{Binding SetInspectorPresetCommand}" CommandParameter="100000" Margin="1,2"/>
                                        <Button Classes="chip" Content="1MΩ" Command="{Binding SetInspectorPresetCommand}" CommandParameter="1000000" Margin="1,2"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding IsCapacitorSelected}">
                                    <TextBlock Text="Capacitor Presets:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="chip" Content="100pF" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.0000000001" Margin="1,2"/>
                                        <Button Classes="chip" Content="1nF" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.000000001" Margin="1,2"/>
                                        <Button Classes="chip" Content="10nF" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.00000001" Margin="1,2"/>
                                        <Button Classes="chip" Content="100nF" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.0000001" Margin="1,2"/>
                                        <Button Classes="chip" Content="1µF" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.000001" Margin="1,2"/>
                                        <Button Classes="chip" Content="10µF" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.00001" Margin="1,2"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding IsInductorSelected}">
                                    <TextBlock Text="Inductor Presets:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="chip" Content="1µH" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.000001" Margin="1,2"/>
                                        <Button Classes="chip" Content="10µH" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.00001" Margin="1,2"/>
                                        <Button Classes="chip" Content="100µH" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.0001" Margin="1,2"/>
                                        <Button Classes="chip" Content="1mH" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.001" Margin="1,2"/>
                                        <Button Classes="chip" Content="10mH" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.01" Margin="1,2"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding IsVoltageSourceSelected}">
                                    <TextBlock Text="Voltage Presets:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="chip" Content="1.2V" Command="{Binding SetInspectorPresetCommand}" CommandParameter="1.2" Margin="1,2"/>
                                        <Button Classes="chip" Content="3.3V" Command="{Binding SetInspectorPresetCommand}" CommandParameter="3.3" Margin="1,2"/>
                                        <Button Classes="chip" Content="5V" Command="{Binding SetInspectorPresetCommand}" CommandParameter="5" Margin="1,2"/>
                                        <Button Classes="chip" Content="9V" Command="{Binding SetInspectorPresetCommand}" CommandParameter="9" Margin="1,2"/>
                                        <Button Classes="chip" Content="12V" Command="{Binding SetInspectorPresetCommand}" CommandParameter="12" Margin="1,2"/>
                                        <Button Classes="chip" Content="24V" Command="{Binding SetInspectorPresetCommand}" CommandParameter="24" Margin="1,2"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding IsCurrentSourceSelected}">
                                    <TextBlock Text="Current Presets:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="chip" Content="10µA" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.00001" Margin="1,2"/>
                                        <Button Classes="chip" Content="100µA" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.0001" Margin="1,2"/>
                                        <Button Classes="chip" Content="1mA" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.001" Margin="1,2"/>
                                        <Button Classes="chip" Content="10mA" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.01" Margin="1,2"/>
                                        <Button Classes="chip" Content="100mA" Command="{Binding SetInspectorPresetCommand}" CommandParameter="0.1" Margin="1,2"/>
                                        <Button Classes="chip" Content="1A" Command="{Binding SetInspectorPresetCommand}" CommandParameter="1.0" Margin="1,2"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Waveform Selector -->
                                <StackPanel Spacing="4" IsVisible="{Binding IsVoltageSourceSelected}">
                                    <TextBlock Text="Waveform:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Classes="chip" Content="DC" Command="{Binding SetWaveformCommand}" CommandParameter="dc"/>
                                        <Button Classes="chip" Content="Sine" Command="{Binding SetWaveformCommand}" CommandParameter="sine"/>
                                        <Button Classes="chip" Content="Pulse" Command="{Binding SetWaveformCommand}" CommandParameter="pulse"/>
                                        <Button Classes="chip" Content="Triangle" Command="{Binding SetWaveformCommand}" CommandParameter="triangle"/>
                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- Live Physics & Thermal Metrics Card -->
                        <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusLg}" Padding="12"
                                IsVisible="{Binding HasNoSelection}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ENVIRONMENTAL PHYSICS" FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeBody}" 
                                           Foreground="{DynamicResource CircuitAccentBrush}" LetterSpacing="0.5"/>

                                <!-- Operating Environment Selector -->
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Operating Environment:" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                    <ComboBox ItemsSource="{Binding TemperaturePresets}" 
                                              SelectedItem="{Binding SelectedTemperaturePreset}"
                                              HorizontalAlignment="Stretch" 
                                              Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                              Foreground="{DynamicResource CircuitAccentBrush}" 
                                              BorderBrush="{DynamicResource CircuitBorderBrush}" 
                                              CornerRadius="{DynamicResource CircuitRadiusSm}" 
                                              FontSize="{DynamicResource CircuitFontSizeBody}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Ambient Temp (T)" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                        <TextBlock Text="{Binding OperatingTemperatureKelvin, StringFormat='{}{0:F2} K'}" FontWeight="SemiBold" 
                                                   FontSize="{DynamicResource CircuitFontSizeLabel}" Foreground="{DynamicResource CircuitTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Thermal Voltage (Vt)" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                        <TextBlock Text="{Binding ThermalVoltageLabel}" FontWeight="SemiBold" 
                                                   FontSize="{DynamicResource CircuitFontSizeLabel}" Foreground="{DynamicResource CircuitSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Separator Background="{DynamicResource CircuitBorderSubtleBrush}" Height="1"/>
                                <TextBlock Text="Integration: MNA Trapezoidal / Gear-2" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="Convergence: Newton-Raphson &lt; 1 µV" FontSize="{DynamicResource CircuitFontSizeSmall}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Interactive Circuit Building Shortcuts & Tips -->
                        <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusLg}" Padding="10"
                                IsVisible="{Binding !HasSelectedDevice}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Quick Shortcuts &amp; Builder Guide" FontWeight="SemiBold" 
                                           FontSize="{DynamicResource CircuitFontSizeBody}" Foreground="{DynamicResource CircuitTextBrush}"/>
                                <TextBlock Text="• Click Pin ➔ Click Pin to wire" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• Drag devices with 60fps grid snap" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• Click switches to toggle open/closed" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• R = Rotate selected component" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• Del = Delete component or wire" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• W = Wire Mode | V = Select Mode" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• X = Cut Mode | F = Fit to screen" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                                <TextBlock Text="• Esc = Cancel wire or placement" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- SPICE Netlist Modal Drawer -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource CircuitScrimBrush}" IsVisible="{Binding IsSpiceDrawerOpen}" ZIndex="100">
                <Border Width="880" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource CircuitSurfaceBrush}"
                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="{DynamicResource CircuitRadiusXl}"
                        BoxShadow="{DynamicResource CircuitModalShadow}" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <material:MaterialIcon Kind="CodeJson" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                        <TextBlock Text="SPICE 3f5 / LTSPICE" FontSize="{DynamicResource CircuitFontSizeBodySm}" 
                                                   FontWeight="Bold" Foreground="{DynamicResource CircuitTextDimBrush}" FontFamily="{DynamicResource CircuitCodeFont}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="SPICE Simulation Deck &amp; Netlist Architecture" 
                                           FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeHeading}" 
                                           Foreground="{DynamicResource CircuitTextWhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="chip" Command="{Binding ToggleSpiceDrawerCommand}" ToolTip.Tip="Close SPICE Deck (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource CircuitDangerBrush}"/>
                                    <TextBlock Text="Close" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Code Editor Container -->
                        <Border Grid.Row="1" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="2">
                            <TextBox Text="{Binding SpiceNetlistText, Mode=TwoWay}"
                                     FontFamily="{DynamicResource CircuitCodeFont}" FontSize="{DynamicResource CircuitFontSizeLabel}"
                                     Foreground="{DynamicResource CircuitSecondaryBrush}" Background="Transparent" BorderThickness="0"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     Padding="12,10"/>
                        </Border>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Classes="toolbtn" Command="{Binding GenerateSpiceNetlistCommand}" ToolTip.Tip="Re-extract fresh netlist from current schematic">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource CircuitAccentBrush}"/>
                                        <TextBlock Text="Re-export from Circuit" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbtn" Command="{Binding CopySpiceToClipboardCommand}" ToolTip.Tip="Copy deck to system clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="ContentCopy" Width="13" Height="13"/>
                                        <TextBlock Text="Copy to Clipboard" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbtn" Command="{Binding ImportSpiceDeckCommand}" ToolTip.Tip="Synthesize and import netlist into canvas schematic">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="Download" Width="13" Height="13" Foreground="{DynamicResource CircuitSecondaryBrush}"/>
                                        <TextBlock Text="Import Deck to Canvas" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                    CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="8,4">
                                <TextBlock Text="Standard Berkeley SPICE 3f5, LTspice, ngspice &amp; WRSPICE compatible" 
                                           FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Bill of Materials (BOM) Modal Drawer -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource CircuitScrimBrush}" IsVisible="{Binding IsBomDrawerOpen}" ZIndex="100">
                <Border Width="1100" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource CircuitSurfaceBrush}"
                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="{DynamicResource CircuitRadiusXl}"
                        BoxShadow="{DynamicResource CircuitModalShadow}" Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <material:MaterialIcon Kind="FileTableOutline" Width="14" Height="14" Foreground="{DynamicResource CircuitTextDimBrush}"/>
                                        <TextBlock Text="MIL-SPEC / IPC CLASS 3" FontSize="{DynamicResource CircuitFontSizeBodySm}" 
                                                   FontWeight="Bold" Foreground="{DynamicResource CircuitTextDimBrush}" FontFamily="{DynamicResource CircuitCodeFont}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Manufacturing Bill of Materials (BOM) • Procurement &amp; Assembly" 
                                           FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeHeading}" 
                                           Foreground="{DynamicResource CircuitTextWhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="chip" Command="{Binding ToggleBomDrawerCommand}" ToolTip.Tip="Close BOM (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource CircuitDangerBrush}"/>
                                    <TextBlock Text="Close" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Code / Markdown Container -->
                        <Border Grid.Row="1" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="2">
                            <TextBox Text="{Binding BomText, Mode=TwoWay}"
                                     FontFamily="{DynamicResource CircuitCodeFont}" FontSize="{DynamicResource CircuitFontSizeBody}"
                                     Foreground="{DynamicResource CircuitTextBrush}" Background="Transparent" BorderThickness="0"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" IsReadOnly="True"
                                     Padding="12,10"/>
                        </Border>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Classes="toolbtn" Command="{Binding GenerateBomCommand}" ToolTip.Tip="Regenerate BOM breakdown from current design">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource CircuitSecondaryBrush}"/>
                                        <TextBlock Text="Re-generate BOM" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbtn" Command="{Binding CopyBomToClipboardCommand}" ToolTip.Tip="Copy BOM table to system clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="ContentCopy" Width="13" Height="13"/>
                                        <TextBlock Text="Copy BOM Markdown" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                    CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="8,4">
                                <TextBlock Text="Standardized RefDes &amp; SMD Packaging (DigiKey / Mouser / JLCPCB ready)" 
                                           FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- AI / LLM Circuit Assistant Modal Drawer -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource CircuitScrimBrush}" IsVisible="{Binding IsLlmDrawerOpen}" ZIndex="100">
                <Border Width="1100" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource CircuitSurfaceBrush}"
                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                        CornerRadius="{DynamicResource CircuitRadiusXl}"
                        BoxShadow="{DynamicResource CircuitModalShadow}" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Background="{DynamicResource CircuitSurfaceHighBrush}" 
                                        BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                        CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <material:MaterialIcon Kind="AutoFixHigh" Width="14" Height="14" Foreground="{DynamicResource CircuitAccentCyanBrush}"/>
                                        <TextBlock Text="AI CIRCUIT ARCHITECT" FontSize="{DynamicResource CircuitFontSizeBodySm}" 
                                                   FontWeight="Bold" Foreground="{DynamicResource CircuitAccentCyanBrush}" FontFamily="{DynamicResource CircuitCodeFont}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="AI Circuit Deck &amp; Turnkey Prompt Studio (.fcircuit)" 
                                           FontWeight="Bold" FontSize="{DynamicResource CircuitFontSizeHeading}" 
                                           Foreground="{DynamicResource CircuitTextWhiteBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="chip" Command="{Binding ToggleLlmDrawerCommand}" ToolTip.Tip="Close AI Studio (Esc)">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <material:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource CircuitDangerBrush}"/>
                                    <TextBlock Text="Close" FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Sub-header: Quick Template Chips & Action Buttons -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                            <!-- Quick Template Chips -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Templates:" FontSize="{DynamicResource CircuitFontSizeBodySm}" 
                                           Foreground="{DynamicResource CircuitTextDimBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button Classes="chip" Command="{Binding LoadLlmTemplateCommand}" CommandParameter="RC Low-Pass Filter" ToolTip.Tip="Load RC Low-Pass Filter Template">
                                    <TextBlock Text="RC Filter" FontSize="{DynamicResource CircuitFontSizeBodySm}"/>
                                </Button>
                                <Button Classes="chip" Command="{Binding LoadLlmTemplateCommand}" CommandParameter="Inverting Op-Amp" ToolTip.Tip="Load Inverting Op-Amp Template">
                                    <TextBlock Text="Op-Amp Inverter" FontSize="{DynamicResource CircuitFontSizeBodySm}"/>
                                </Button>
                                <Button Classes="chip" Command="{Binding LoadLlmTemplateCommand}" CommandParameter="BJT LED Driver" ToolTip.Tip="Load Transistor Switch Driver">
                                    <TextBlock Text="BJT Switch" FontSize="{DynamicResource CircuitFontSizeBodySm}"/>
                                </Button>
                                <Button Classes="chip" Command="{Binding LoadLlmTemplateCommand}" CommandParameter="555 Timer Oscillator" ToolTip.Tip="Load 555 Pulse Generator">
                                    <TextBlock Text="555 Timer" FontSize="{DynamicResource CircuitFontSizeBodySm}"/>
                                </Button>
                            </StackPanel>

                            <!-- Mode Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Button Classes="toolbtn" Command="{Binding CopyLlmPromptToClipboardCommand}" ToolTip.Tip="Copy turnkey system prompt with schema &amp; few-shots for ChatGPT/Claude">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="ClipboardTextOutline" Width="13" Height="13" Foreground="{DynamicResource CircuitAccentCyanBrush}"/>
                                        <TextBlock Text="Copy AI Prompt" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbtn" Command="{Binding GenerateLlmDeckCommand}" ToolTip.Tip="Sync current canvas schematic into .fcircuit JSON">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource CircuitSecondaryBrush}"/>
                                        <TextBlock Text="Sync From Canvas" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Code / JSON Editor Container -->
                        <Border Grid.Row="2" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                CornerRadius="{DynamicResource CircuitRadiusMd}" Padding="2">
                            <TextBox Text="{Binding LlmCircuitText, Mode=TwoWay}"
                                     FontFamily="{DynamicResource CircuitCodeFont}" FontSize="{DynamicResource CircuitFontSizeBody}"
                                     Foreground="{DynamicResource CircuitTextBrush}" Background="Transparent" BorderThickness="0"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     PlaceholderText="Paste .fcircuit JSON or conversational markdown code block from ChatGPT / Claude / Gemini here..."
                                     Padding="12,10"/>
                        </Border>

                        <!-- Footer Actions -->
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Classes="toolbtn" Classes.simplay="True" Command="{Binding ImportLlmDeckCommand}" ToolTip.Tip="Parse JSON/markdown, auto-layout (if needed), route wires, and simulate">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="LightningBolt" Width="14" Height="14" Foreground="{DynamicResource CircuitTextWhiteBrush}"/>
                                        <TextBlock Text="Import &amp; Simulate" FontWeight="Bold" Foreground="{DynamicResource CircuitTextWhiteBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbtn" Command="{Binding CopyLlmJsonToClipboardCommand}" ToolTip.Tip="Copy .fcircuit JSON to clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <material:MaterialIcon Kind="ContentCopy" Width="13" Height="13"/>
                                        <TextBlock Text="Copy JSON" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource CircuitSurfaceLowBrush}" 
                                    BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="1" 
                                    CornerRadius="{DynamicResource CircuitRadiusSm}" Padding="8,4">
                                <TextBlock Text="Prompt &amp; JSON compatible with Claude 3.7, GPT-4o, Gemini 2.0, DeepSeek, &amp; Ollama" 
                                           FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CircuitSurfaceLowestBrush}" 
                BorderBrush="{DynamicResource CircuitBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource CircuitSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource CircuitFontSizeBodySm}" 
                               Foreground="{DynamicResource CircuitTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="FryCircuit Engine v2.0 • MNA Solver • 60 FPS • Industry Standard Architecture" 
                           FontSize="{DynamicResource CircuitFontSizeBodySm}" Foreground="{DynamicResource CircuitTextMutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>

</UserControl>
